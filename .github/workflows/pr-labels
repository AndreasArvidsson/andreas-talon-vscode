name: PR labels

on:
    pull_request:
        types: [opened, synchronize, reopened]
    pull_request_review:
        types: [submitted]

permissions:
    pull-requests: read
    issues: write

jobs:
    labels:
        runs-on: ubuntu-latest
        steps:
            - name: Update PR labels
              uses: AndreasArvidsson/gh-pr-labeler@main
